<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:c="/lib/credentials">
  <f:section title="Applitools Eyes">
    <f:description>
      Visual review on pull requests. Defaults for every <code>applitools { }</code> step; a Jenkinsfile can override them.
      To check that everything works, open <a href="${rootURL}/manage/applitools-setup">Applitools setup</a>.
    </f:description>

    <f:section title="Eyes server">
      <f:entry title="Server URL" field="serverUrl">
        <f:textbox default="${descriptor.DEFAULT_SERVER_URL}" />
      </f:entry>
    </f:section>

    <f:section title="API keys">
      <f:entry title="Run key" field="credentialsId"
               description="Uploads test results. Secret text credential.">
        <c:select default="${descriptor.DEFAULT_CREDENTIALS_ID}" />
      </f:entry>
      <f:entry title="Read key" field="readCredentialsId"
               description="Reads results, approvals and Eyes teams. Empty: uses applitools-read-api-key if it exists.">
        <c:select />
      </f:entry>
      <f:entry title="Merge key" field="mergeCredentialsId"
               description="Merges baselines when a pull request merges. Empty: uses applitools-merge-api-key if it exists.">
        <c:select />
      </f:entry>
    </f:section>

    <f:section title="Pull request results">
      <f:entry title="Report to GitHub as" field="githubReporting">
        <f:enum>${it.displayName}</f:enum>
      </f:entry>
      <f:entry field="designReviewCheck">
        <f:checkbox title="Post the &quot;Applitools / Design review&quot; result on every pull request" default="true" />
      </f:entry>
    </f:section>

    <f:section title="Design review">
      <f:entry title="Designers" field="designers"
               description="Who can approve: team:&lt;Eyes team&gt; and/or Eyes login emails, one per line or comma-separated. Empty: anyone.">
        <f:textarea />
      </f:entry>
      <f:entry title="Label" field="designReviewLabel"
               description="Adding this label to a pull request requires a designer's approval.">
        <f:textbox default="${descriptor.DEFAULT_DESIGN_REVIEW_LABEL}" />
      </f:entry>
      <f:entry field="designReviewByDefault">
        <f:checkbox title="Require design review on every pull request, not just labeled ones" />
      </f:entry>
      <f:entry field="lockDesignReview">
        <f:checkbox title="Jenkinsfiles can't loosen design review (turn it off, choose designers, change the label)" />
      </f:entry>
    </f:section>

    <f:section title="Baselines">
      <f:entry field="mergeBaselines">
        <f:checkbox title="When a pull request merges, merge its Eyes baselines into the target branch" default="true" />
      </f:entry>
      <f:entry field="commentOnUnmergedBaselines">
        <f:checkbox title="When a merged pull request's baselines can't be merged, comment on it and label it" default="true" />
      </f:entry>
      <f:entry field="unstableWhileUnmerged">
        <f:checkbox title="Mark target branch builds unstable until those baselines are merged" default="true" />
      </f:entry>
    </f:section>

    <f:advanced title="Review polling">
      <f:description>
        After a build, the plugin checks Eyes for reviewers' decisions and updates the pull request.
        It checks less often as a review ages. Pull requests reported with a token are checked on GitHub on the same schedule.
      </f:description>
      <f:entry title="Check every (seconds)" field="reviewPollSeconds"
               description="How often to check a new review. At least 15.">
        <f:number min="15" default="${descriptor.DEFAULT_REVIEW_POLL_SECONDS}" />
      </f:entry>
      <f:entry title="Slow down after (minutes)" field="reviewSlowAfterMinutes">
        <f:number min="1" default="${descriptor.DEFAULT_REVIEW_SLOW_AFTER_MINUTES}" />
      </f:entry>
      <f:entry title="Then check every (minutes)" field="reviewSlowPollMinutes">
        <f:number min="1" default="${descriptor.DEFAULT_REVIEW_SLOW_POLL_MINUTES}" />
      </f:entry>
      <f:entry title="Slow down again after (hours)" field="reviewSlowestAfterHours">
        <f:number min="1" default="${descriptor.DEFAULT_REVIEW_SLOWEST_AFTER_HOURS}" />
      </f:entry>
      <f:entry title="Then check every (minutes)" field="reviewSlowestPollMinutes">
        <f:number min="1" default="${descriptor.DEFAULT_REVIEW_SLOWEST_POLL_MINUTES}" />
      </f:entry>
      <f:entry title="Recheck fully reviewed pull requests every (minutes)" field="settledRecheckMinutes"
               description="Catches a reviewer changing their mind in Eyes after everything was approved or rejected.">
        <f:number min="1" default="${descriptor.DEFAULT_SETTLED_RECHECK_MINUTES}" />
      </f:entry>
      <f:entry title="Stop following a review after (days)" field="followReviewsDays">
        <f:number min="1" max="365" default="${descriptor.DEFAULT_FOLLOW_REVIEWS_DAYS}" />
      </f:entry>
    </f:advanced>

    <f:advanced title="Advanced">
      <f:entry field="followBranchBuilds">
        <f:checkbox title="Keep updating results for branch builds (not just pull requests) after they finish" />
      </f:entry>
      <f:entry field="hideReviewers">
        <f:checkbox title="Don't name reviewers in pull request results (their Eyes login emails), e.g. for public repositories" />
      </f:entry>
      <f:entry field="allowForkPullRequests">
        <f:checkbox title="Run visual tests on pull requests from forks (their code gets the Eyes run key)" />
      </f:entry>
      <f:entry field="allowHttp">
        <f:checkbox title="Allow http:// Eyes and GitHub URLs on other machines (keys travel unencrypted)" />
      </f:entry>
      <f:entry field="apiKeyInQuery">
        <f:checkbox title="Older on-premises Eyes: retry closing batches with the run key in the URL" />
      </f:entry>
    </f:advanced>
  </f:section>
</j:jelly>
