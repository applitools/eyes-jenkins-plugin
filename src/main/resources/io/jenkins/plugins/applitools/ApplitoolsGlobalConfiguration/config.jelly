<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:c="/lib/credentials">
  <f:section title="Applitools Eyes">
    <f:entry title="Eyes server URL" field="serverUrl">
      <f:textbox default="${descriptor.DEFAULT_SERVER_URL}" />
    </f:entry>
    <f:entry title="Default API key credential" field="credentialsId">
      <c:select default="${descriptor.DEFAULT_CREDENTIALS_ID}" />
    </f:entry>
    <f:entry title="Default read API key credential" field="readCredentialsId">
      <c:select />
    </f:entry>
    <f:entry field="designReviewCheck">
      <f:checkbox title="Post the &quot;Applitools / Design review&quot; check on pull requests" default="true" />
    </f:entry>
    <f:entry title="Design review label" field="designReviewLabel">
      <f:textbox default="${descriptor.DEFAULT_DESIGN_REVIEW_LABEL}" />
    </f:entry>
    <f:entry title="Designers" field="designers">
      <f:textarea />
    </f:entry>
    <f:entry field="designReviewByDefault">
      <f:checkbox title="Require design review on every pull request, not just labeled ones" />
    </f:entry>
    <f:entry field="mergeBaselines">
      <f:checkbox title="Merge a pull request's Eyes baselines into its target branch when it merges" default="true" />
    </f:entry>
    <f:entry title="Baseline merge API key credential" field="mergeCredentialsId">
      <c:select />
    </f:entry>
  </f:section>
</j:jelly>
